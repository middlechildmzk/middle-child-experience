{
  "name": "middle-child-experience",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "bridge:check-readonly": "node scripts/check-bridge-readonly.mjs",
    "bridge:smoke": "node --import tsx --test tests/bridge/*.test.ts tests/bridge/*.test.mjs",
    "test:db": "node --test tests/db/*.test.mjs",
    "test:source-health": "node --import tsx --test tests/source-health/*.test.ts",
    "test": "npm run bridge:smoke && npm run test:db && npm run test:source-health && npm run test:learn && npm run test:tools",
    "test:learn": "node --import tsx --test tests/learn/*.test.ts",
    "test:tools": "node --import tsx --test tests/tools/*.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.0.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
